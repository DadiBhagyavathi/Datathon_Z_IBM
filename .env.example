# ==============================================================================
# SecureAI Gateway — Environment Configuration Template
# Copy this file to .env before starting the services.
# NEVER commit .env to version control!
# ==============================================================================

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=secureai_user
DB_PASSWORD=secureai_pass
DB_NAME=secureai
DB_SSLMODE=disable

# Go Security Backend Configuration
BACKEND_PORT=8080
BACKEND_HOST=0.0.0.0
AI_ENGINE_URL=http://127.0.0.1:8000
ENVIRONMENT=development

# Python AI Engine Configuration
AI_ENGINE_PORT=8000
AI_ENGINE_HOST=127.0.0.1
# Adapter options: 'mock' or 'granite'
AI_INFERENCE_ADAPTER=mock
# Optional IBM Granite Endpoint & API Key (Leave blank if using mock adapter)
GRANITE_API_ENDPOINT=
GRANITE_API_KEY=
GRANITE_MODEL_ID=ibm/granite-13b-chat-v2

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
